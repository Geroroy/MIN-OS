#!/bin/sh
# 하그라 세션 진입점 — greetd 또는 wayland-sessions 항목에서 실행된다.
# 환경을 준비하고 labwc(컴포지터)를 실행한다. labwc 종료 = 세션 종료.
set -u

export XDG_CURRENT_DESKTOP=HAGRA
export XDG_SESSION_DESKTOP=hagra
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export MOZ_ENABLE_WAYLAND=1

# 세션 로그
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/hagra
mkdir -p "$STATE_DIR" 2>/dev/null && exec >>"$STATE_DIR/session.log" 2>&1
echo "== hagra-session start $(date -Is) user=$(id -un) tty=$(tty 2>/dev/null)"

# 소프트웨어 렌더링 판단:
#  - 커널 명령행 hagra.render=software (강제) / hagra.render=gl (강제 GL)
#  - 렌더 노드가 없음
#  - 가상 GPU(virtio-gpu, bochs, simpledrm, vmwgfx): 3D 가속이 없어 EGL 이 llvmpipe 로 떨어지면 TCG 에서 매우 느리다
SW=0
if grep -qw 'hagra.render=software' /proc/cmdline 2>/dev/null; then SW=1
elif grep -qw 'hagra.render=gl' /proc/cmdline 2>/dev/null; then SW=0
elif ! ls /dev/dri/renderD* >/dev/null 2>&1; then SW=1
else
  for d in /sys/class/drm/card[0-9]*/device/driver; do
    case "$(basename "$(readlink -f "$d" 2>/dev/null)")" in
      virtio-pci|virtio_gpu|bochs-drm|bochs|simple-framebuffer|simpledrm|cirrus|vmwgfx|qxl) SW=1 ;;
    esac
  done
fi
if [ "$SW" = 1 ]; then
  export WLR_RENDERER=pixman
  export QT_QUICK_BACKEND=software
  echo "software rendering enabled"
fi

# labwc 설정 디렉터리 조립 (파일 단위 우선순위: 사용자 재정의 > 테마 관리 파일 > 시스템 기본)
#   사용자 재정의: ~/.config/hagra/labwc/<파일>  (있는 파일만 덮는다; 예전처럼 디렉터리 전체를 둘 수도 있다)
#   테마 관리:     themerc-override 만 — hagra-theme 가 저장된 선택(~/.config/hagra/theme.conf)으로 상태 디렉터리에 쓴다.
#                  사용자가 themerc-override 를 직접 두면 그것이 이긴다 (테마 전환이 개인 설정을 덮지 않음).
#   시스템 기본:   /etc/hagra/labwc/
SYSCONF=/etc/hagra/labwc
USERCONF=$HOME/.config/hagra/labwc
CONF=${XDG_RUNTIME_DIR:-/tmp}/hagra-labwc-$(id -u)
mkdir -p "$CONF" && rm -f "$CONF"/*
THEME_STATE=""
if command -v hagra-theme >/dev/null 2>&1; then
  hagra-theme sync >/dev/null 2>&1 && THEME_STATE=$(hagra-theme state-dir 2>/dev/null)
fi
for f in rc.xml menu.xml environment autostart themerc-override; do
  if [ -e "$USERCONF/$f" ]; then ln -sf "$USERCONF/$f" "$CONF/$f"
  elif [ "$f" = themerc-override ] && [ -n "$THEME_STATE" ] && [ -s "$THEME_STATE/themerc-override" ]; then ln -sf "$THEME_STATE/themerc-override" "$CONF/$f"
  elif [ -e "$SYSCONF/$f" ]; then ln -sf "$SYSCONF/$f" "$CONF/$f"
  fi
done
echo "labwc config dir: $CONF (user=$USERCONF theme-state=${THEME_STATE:-none})"

# 세션 D-Bus (systemd --user + dbus-user-session 이 있으면 이미 설정되어 있다)
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
  exec dbus-run-session -- labwc -C "$CONF" "$@"
fi
exec labwc -C "$CONF" "$@"
