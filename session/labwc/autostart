# 하그라 세션 자동 시작 (labwc가 /bin/sh 로 실행)
# 배경: HAGRA_WALLPAPER(개발·테스트) > 테마 관리자(사용자 지정 배경 > 선택 테마 배경) > 기본 테마 파일
WALL=${HAGRA_WALLPAPER:-}
FILL='#E3ECE6'
if [ -z "$WALL" ] && command -v hagra-theme >/dev/null 2>&1; then
  WALL=$(hagra-theme wallpaper 2>/dev/null)
  FILL=$(hagra-theme wallpaper-fill 2>/dev/null || echo '#E3ECE6')
fi
[ -n "$WALL" ] || WALL=/usr/share/hagra/wallpaper/hagra-dancheong.png
if [ -f "$WALL" ]; then
  swaybg -i "$WALL" -m fill -c "$FILL" >/dev/null 2>&1 &
else
  swaybg -c "$FILL" >/dev/null 2>&1 &
fi

# systemd --user / D-Bus 활성화 환경에 Wayland 디스플레이 전달 (포털, 알림 등)
systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP QT_QPA_PLATFORM 2>/dev/null
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP QT_QPA_PLATFORM 2>/dev/null

# 하그라 셸 (로그: $XDG_RUNTIME_DIR/hagra-shell.log)
[ "${HAGRA_SHELL:-hagra-shell}" = none ] || "${HAGRA_SHELL:-hagra-shell}" >"${XDG_RUNTIME_DIR:-/tmp}/hagra-shell.log" 2>&1 &
