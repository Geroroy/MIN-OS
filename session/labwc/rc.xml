<?xml version="1.0"?>
<!-- 하그라 labwc 설정. 시스템: /etc/hagra/labwc/rc.xml, 사용자 재정의: ~/.config/hagra/labwc/rc.xml -->
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>0</gap>
    <adaptiveSync>no</adaptiveSync>
    <reuseOutputMode>yes</reuseOutputMode>
  </core>

  <placement>
    <policy>center</policy>
  </placement>

  <!-- 밝은 청자빛 제목 표시줄, 2px 경계. 색상은 themerc-override(생성 파일) 참고 -->
  <theme>
    <!-- 값은 design/tokens/hagra.tokens.json 의 window.cornerRadius / window.titleFontPt 와 맞춘다 (rc.xml 은 생성 대상이 아님) -->
    <cornerRadius>2</cornerRadius>
    <keepBorder>yes</keepBorder>
    <font place="ActiveWindow" name="Noto Sans CJK KR" size="12" weight="bold" />
    <font place="InactiveWindow" name="Noto Sans CJK KR" size="12" weight="normal" />
    <font place="MenuItem" name="Noto Sans CJK KR" size="11" />
    <font place="OnScreenDisplay" name="Noto Sans CJK KR" size="11" />
  </theme>

  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <!-- 창 가장자리 끌기 스냅 (labwc 0.7): 화면 가장자리 10px 안에서 놓으면 반 화면, 위쪽은 최대화 -->
  <snapping>
    <range>10</range>
    <topMaximize>yes</topMaximize>
  </snapping>

  <!-- Alt+Tab 창 전환: 목록형 OSD, 미리보기 없음 (최소 애니메이션 원칙) -->
  <windowSwitcher show="yes" preview="no" outlines="yes" allWorkspaces="no">
    <fields>
      <field content="type" width="20%" />
      <field content="title" width="80%" />
    </fields>
  </windowSwitcher>

  <!-- 작업 공간 4개: Super+1~4 이동, Super+Shift+1~4 창 보내기. 전환 OSD 는 labwc 기본 -->
  <desktops number="4">
    <names><name>1</name><name>2</name><name>3</name><name>4</name></names>
  </desktops>

  <keyboard>
    <default />
    <!-- 하그라 단축키 (docs/DESIGN_LANGUAGE.md §6) -->
    <keybind key="W-Return"><action name="Execute" command="foot" /></keybind>
    <keybind key="W-space"><action name="Execute" command="hagra-shell --toggle-launcher" /></keybind>
    <keybind key="W-e"><action name="Execute" command="hagra-shell --show-launcher" /></keybind>
    <keybind key="W-Escape"><action name="Execute" command="hagra-shell --power" /></keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
    <keybind key="W-q"><action name="Close" /></keybind>
    <keybind key="W-Up"><action name="ToggleMaximize" /></keybind>
    <keybind key="W-Down"><action name="Iconify" /></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" /></keybind>
    <keybind key="A-Tab"><action name="NextWindow" /></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow" /></keybind>
    <keybind key="W-S-r"><action name="Reconfigure" /></keybind>
    <keybind key="W-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4" /></keybind>
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" /></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" /></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" /></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" /></keybind>
    <keybind key="W-C-Left"><action name="GoToDesktop" to="left" wrap="yes" /></keybind>
    <keybind key="W-C-Right"><action name="GoToDesktop" to="right" wrap="yes" /></keybind>
    <keybind key="W-f"><action name="ToggleFullscreen" /></keybind>
    <keybind key="W-S-Up"><action name="SnapToEdge" direction="up" /></keybind>
    <keybind key="W-S-Down"><action name="SnapToEdge" direction="down" /></keybind>
    <keybind key="W-i"><action name="Execute" command="hagra-shell --settings" /></keybind>
    <keybind key="W-n"><action name="Execute" command="hagra-shell --notifications" /></keybind>
  </keyboard>

  <mouse>
    <default />
    <context name="Root">
      <mousebind button="Right" action="Press"><action name="ShowMenu" menu="root-menu" /></mousebind>
      <mousebind button="Middle" action="Press"><action name="Execute" command="hagra-shell --toggle-launcher" /></mousebind>
    </context>
    <context name="TitleBar">
      <mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize" /></mousebind>
    </context>
  </mouse>

  <libinput>
    <device category="default">
      <naturalScroll>no</naturalScroll>
      <tap>yes</tap>
    </device>
  </libinput>
</labwc_config>
