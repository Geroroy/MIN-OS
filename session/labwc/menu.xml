<?xml version="1.0" encoding="UTF-8"?>
<!-- 하그라 바탕 화면 우클릭 메뉴 (labwc root-menu). 시스템: /etc/hagra/labwc/menu.xml, 사용자 재정의: ~/.config/hagra/labwc/menu.xml
     모든 항목은 실제 명령에 연결된다. 설정 항목은 hagra-settings 를 해당 페이지로 연다 (셸 IPC 경유: 설정 앱이 없으면 셸 내장 모양 창). -->
<openbox_menu>
  <menu id="root-menu" label="하그라">
    <item label="응용 프로그램 (Super+Space)"><action name="Execute"><command>hagra-shell --show-launcher</command></action></item>
    <item label="터미널 (Super+Enter)"><action name="Execute"><command>hagra-shell --terminal</command></action></item>
    <item label="웹 브라우저 (Super+B)"><action name="Execute"><command>hagra-browser</command></action></item>
    <separator />
    <menu id="personalize-menu" label="개인 설정">
      <item label="배경 바꾸기"><action name="Execute"><command>hagra-shell --settings wallpaper</command></action></item>
      <item label="모양과 테마"><action name="Execute"><command>hagra-shell --settings appearance</command></action></item>
      <item label="디스플레이 설정"><action name="Execute"><command>hagra-shell --settings display</command></action></item>
    </menu>
    <item label="설정"><action name="Execute"><command>hagra-shell --settings</command></action></item>
    <separator />
    <item label="설정 다시 읽기"><action name="Reconfigure" /></item>
    <item label="전원 (Super+Esc)"><action name="Execute"><command>hagra-shell --power</command></action></item>
  </menu>

  <!-- 창 제목줄 우클릭 메뉴 (labwc 0.7 client-menu 재정의) -->
  <menu id="client-menu" label="창">
    <item label="최소화"><action name="Iconify" /></item>
    <item label="최대화 / 복원"><action name="ToggleMaximize" /></item>
    <item label="전체 화면"><action name="ToggleFullscreen" /></item>
    <item label="항상 위"><action name="ToggleAlwaysOnTop" /></item>
    <separator />
    <menu id="client-send-to-menu" label="작업 공간으로 보내기" />
    <separator />
    <item label="닫기"><action name="Close" /></item>
  </menu>
</openbox_menu>
